{
  "name": "DwellyHack",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "eve start",
    "typecheck": "tsc",
    "crm:import": "node crm/import.ts --all --reset",
    "reality": "node runner/reality.ts --out ANSWERS --concurrency 4 --cases",
    "practice": "node practice/run.ts",
    "intake:eval": "node intake/eval.ts",
    "test": "node --test crm/*.test.ts intake/*.test.ts runner/*.test.ts"
  },
  "dependencies": {
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.128",
    "eve": "^0.76.0",
    "just-bash": "^3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
